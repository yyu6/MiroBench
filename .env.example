# Copy this file to .env only if desired, or export the relevant key directly.
# Never commit real credentials. The multi-domain runner reads these variables.

OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key

# MiroFish-compatible aliases; run_generation.py sets these automatically.
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
