# Copy to `.env` and fill in your API key before running `mirobench generate`
# or `python -m calibration`. The calibration loop and the generation pipeline
# both call out to an OpenAI-compatible chat completion endpoint.

# Required — your API key for the LLM provider.
LLM_API_KEY=sk-your-key-here

# Optional — API base URL. Default: OpenAI's public endpoint.
LLM_BASE_URL=https://api.openai.com/v1

# Optional — model name (overrides any value in simulation_config.json).
LLM_MODEL_NAME=gpt-4o-mini

# Optional — reasoning effort (only meaningful for reasoning-capable models).
# LLM_REASONING_EFFORT=
